{
  "name": "ascii-field",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive ASCII animal field for the abinbinu.in hero section",
  "main": "dist/ascii-field.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "tsc --noEmit && vite build --mode lib",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
