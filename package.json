{
  "name": "ascii-field",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Fifteen interactive animals drawn in ASCII character cells on one canvas: a living, clickable background for a hero section. TypeScript, zero dependencies.",
  "main": "dist/ascii-field.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "tsc --noEmit && vite build --mode lib",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "shot": "node scripts/shot.mjs"
  },
  "devDependencies": {
    "playwright": "^1.48.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
